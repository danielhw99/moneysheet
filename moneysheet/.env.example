# Reference only: Spring Boot does not automatically load this file.
# Set these in IntelliJ Run Configuration or the process environment.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://127.0.0.1:13306/moneysheet_dev?sslMode=REQUIRED
DB_USERNAME=moneysheet_app
DB_PASSWORD=

# Migration tasks only; no fallback to DB_* application credentials.
MIGRATION_DB_URL=jdbc:mysql://127.0.0.1:13306/moneysheet_dev?sslMode=REQUIRED
MIGRATION_DB_USERNAME=moneysheet_migration
MIGRATION_DB_PASSWORD=

# Signup email verification. No default/dev bypass; absent credentials cause mail requests to fail.
# Gmail SMTP requires an app password for an appropriately secured account, not the normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=moneysheet.site@gmail.com
SMTP_PASSWORD=
MONEYSHEET_MAIL_FROM=moneysheet.site@gmail.com
